{
	"module": "volsite",

	"input_dir": "../dataset/protlig",
	"subdirs": ["1eou", "2rh1", "2zx7", "3gbb", "4d3j"],

	"commands": [
		{
			"id": "01",
			"cmd": "{ichem} volsite {protein}",
			"in_files": {
				"protein": "prepared.mol2"
			},
			"out_files": [
				"VolSite_Stat.csv",
				"CAVITY_N[0-9]+_ALL.mol2",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		},
		{
			"id": "02",
			"cmd": "{ichem} volsite {protein} {ligand}",
			"in_files": {
				"protein": "prepared.mol2",
				"ligand": "ligand.mol2"
			},
			"out_files": [
				"VolSite_Stat.csv",
				"CAVITY_N[0-9]+_ALL.mol2",
				"CAVITY_N[0-9]+_[0-9]{1,2}.mol2",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		}
	]
}