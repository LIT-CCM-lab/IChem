{
	"module": "grim",

	"input_dir": "../dataset/protlig",
	"subdirs": ["1eou", "2rh1", "2zx7", "3gbb", "4d3j"],

	"commands": [
		{
			"id": "01",
			"cmd": "{ichem} -sim 1 -rn ref -cn comp grim {ref_site} {ref_ligand} {comp_site} {comp_ligand}",
			"in_files": {
				"ref_site": "site.mol2",
				"ref_ligand": "ligand.mol2",
				"comp_site": "compare/site.mol2",
				"comp_ligand": "compare/ligand.mol2"
			},
			"out_files": [
				"RefInts.mol2",
				"CompInts.mol2",
				"Grifp_res.csv",
				"GRIM.log",
				"GRIM_prot.mol2",
				"GRIM_lig.mol2",
				"GRIM_ints.mol2",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		},
		{
			"id": "02",
			"cmd": "{ichem} -sim 1 grim {ref_site} {ref_ligand} {docked}",
			"in_files": {
				"ref_site": "prepared.mol2",
				"ref_ligand": "ligand.mol2",
				"docked": "compare/refdock/docked.mol2"
			},
			"out_files": [
				"GrScreen.csv",
				"Grimscreen_res.tsv",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		},
		{
			"id": "03",
			"cmd": "{ichem} -sim 1 grim {ref_site} {ref_ligand} {corrupted_docked}",
			"in_files": {
				"ref_site": "prepared.mol2",
				"ref_ligand": "ligand.mol2",
				"corrupted_docked": "compare/refdock/corrupted_docked.mol2"
			},
			"out_files": [
				"GrScreen.csv",
				"Grimscreen_res.tsv",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		}
	]
}