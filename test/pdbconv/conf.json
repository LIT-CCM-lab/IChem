{
	"module": "pdbconv",

	"input_dir": "../dataset/protlig",
	"subdirs": ["1eou", "2rh1", "2zx7", "3gbb", "4d3j"],

	"commands": [
		{
			"id": "01",
			"cmd": "{ichem} pdbconv {pdb} ./ pdbc",
			"in_files": {
				"pdb": "original.pdb"
			},
			"out_files": [
				"_descriptor.txt",
				"pdbc_1_[A-Z0-9]{3}.mol2",
				"pdbc_1_[A-Z0-9]{3}_PROT.mol2",
				"pdbc_1_[A-Z0-9]{3}_SITE.mol2",
				"pdbc_1_[A-Z0-9]{3}_FULL.mol2",
				"pdbc_1_[A-Z0-9]{3}_CAVITY_N1_ALL.mol2",
				"pdbc_1_[A-Z0-9]{3}_CAVITY_N1_[0-9]{1,2}.mol2",
				"cmd.sh",
				"log.out",
				"log.err"
			]
		}
	]
}